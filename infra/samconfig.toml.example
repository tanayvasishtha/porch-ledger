# Copy to infra/samconfig.toml (gitignored) and fill in real values.
version = 0.1
[default.deploy.parameters]
stack_name = "porch-ledger"
# Home region for this account's Free plan. Bedrock stays in us-east-1 via
# PORCH_AWS__BEDROCK_REGION (the setting's default is already us-east-1).
region = "ap-southeast-2"
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
resolve_s3 = true
s3_prefix = "porch-ledger"
# After the first deploy, set AllowedOrigin to the EchoUrl output and deploy
# again: the MCP transport only accepts browser origins listed exactly.
parameter_overrides = "HouseId=demo RingDeviceId=\"\" ScheduleEnabled=false AlertEmail=\"you@example.com\" AllowedOrigin=\"*\""
